<!DOCTYPE html>
<html>
<head>
    <title>olution iot datas</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="theme-color" content="#008B74" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <noscript><link rel="stylesheet" href="/assets/css/noscript.css" /></noscript>
    
    <!-- Font Awesome avec préchargement et solution de repli SVG -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js" integrity="sha512-GWzVrcGlo0TxTRvz9ttioyYJ+Wwk9Ck0G81D+eO63BaqHaJ3YZX9wuqjwgfcV/MrB2PhaVX9DkYVhbFpStnqpQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    
    <!-- Styles harmonisés avec l'interface aquaponie -->
    <link rel="stylesheet" href="/ffp3/assets/css/realtime-styles.css" />
    <link rel="manifest" href="/ffp3/manifest.json" />
    <link rel="apple-touch-icon" href="/ffp3/assets/icons/icon-192.png" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <link rel="shortcut icon" type="image/png" href="https://iot.olution.info/images/favico.png"/>
    
    <!-- Styles de contrôle extraits vers fichier externe -->
    <link rel="stylesheet" href="/ffp3/assets/css/control-styles.css" />
</head>
<body class="is-preload" data-environment="{{ environment }}">

    <!-- Badge de synchronisation temps réel -->
    <div id="control-sync-badge" class="connecting">CONNEXION...</div>
    
    <!-- Wrapper -->
    <div id="wrapper" class="fade-in control-wrapper">
        
        <!-- Header -->
        <header id="header">
            <a href="https://iot.olution.info/ffp3/" class="logo">n3 iot datas</a>
        </header>

        <!-- Nav -->
        <nav id="nav">
            <ul class="links">
                <li><a href="https://iot.olution.info/ffp3/">Accueil</a></li>
                <li><a href="https://iot.olution.info/ffp3/aquaponie{{ environment == 'test' ? '-test' : '' }}">L'aquaponie (FFP3)</a></li>
                <li class="active"><a href="https://iot.olution.info/ffp3/control{{ environment == 'test' ? '-test' : '' }}">Contrôle</a></li>
                <li><a href="https://iot.olution.info/msp1/msp1datas/msp1-data.php">Le potager</a></li>
                <li><a href="https://iot.olution.info/n3pp/n3ppdatas/n3pp-data.php">L'élevage d'insectes</a></li>
            </ul>
            <ul class="icons">
                <li><a href="https://olution.info/course/view.php?id=511" class="icon solid fa-leaf"><span class="label">olution</span></a></li>
                <li><a href="https://farmflow.marout.org/" class="icon solid fa-fish"><span class="label">farmflow</span></a></li>
            </ul>
        </nav>

        <!-- Main -->
        <div id="main" class="control-layout">
            <aside class="control-sidebar panel">
                <section class="control-context">
                    <div class="context-badges">
                        <span class="context-badge {{ environment == 'test' ? 'context-badge-test' : 'context-badge-prod' }}">
                            <i class="fas fa-globe"></i>
                            {{ environment == 'test' ? 'TEST' : 'PROD' }}
                        </span>
                        <span class="context-badge">
                            <i class="fas fa-code-branch"></i>
                            {{ version }}
                        </span>
                        {% if firmware_version %}
                        <span class="context-badge">
                            <i class="fas fa-microchip"></i>
                            FW {{ firmware_version }}
                        </span>
                        {% endif %}
                    </div>
                    <div class="context-summary">
                        <h2><i class="fas fa-sliders-h"></i> Tableau de bord</h2>
                        <p class="context-description">
                            Commandez les pompes, le chauffage et la programmation automatique du système aquaponique. Chaque action est synchronisée avec l'ESP32 en moins de 4 secondes.
                        </p>
                        <div class="context-stats">
                            <div class="context-stat">
                                <span class="stat-label">Actionneurs</span>
                                <span class="stat-value">{{ outputs|length }}</span>
                            </div>
                            <div class="context-stat">
                                <span class="stat-label">Boards</span>
                                <span class="stat-value">{{ boards|length }}</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="boards-status">
                    <h3><i class="fas fa-satellite-dish"></i> Connexions</h3>
                    
                    <div class="status-grid">
                        <div class="status-card">
                            <div class="status-label">Sync temps réel</div>
                            <div id="system-status-indicator" class="status-indicator status-online is-animated">
                                <span class="status-pill" data-status-badge><i class="fas fa-circle"></i><strong>TEMPS RÉEL</strong></span>
                                <span class="status-text" data-status-label><i class="fas fa-check-circle"></i><span>En ligne</span></span>
                            </div>
                        </div>
                        <div class="status-card">
                            <div class="status-label">Dernière commande</div>
                            <div class="status-value" id="last-reading-time" data-default="pending">
                                <span class="reading-ago" data-reading-ago><i class="fas fa-spinner fa-spin"></i></span>
                                <span class="reading-timestamp" data-reading-timestamp></span>
                            </div>
                        </div>
                        <div class="status-card">
                            <div class="status-label">Lectures aujourd'hui</div>
                            <div class="status-value" id="readings-today" data-default="pending">
                                <span class="reading-count" data-reading-count><i class="fas fa-spinner fa-spin"></i></span>
                                <span class="reading-hint" data-reading-hint>/ jour</span>
                            </div>
                        </div>
                        <div class="status-card">
                            <div class="status-label">Uptime (30j)</div>
                            <div class="status-value" id="system-uptime">
                                <i class="fas fa-spinner fa-spin"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="boards-grid">
                        {% for board in boards %}
                            <article class="board-card" data-board="{{ board.board }}">
                                <header>
                                    <span class="board-title"><i class="fas fa-microchip"></i> Board {{ board.board }}</span>
                                    <span class="board-last">Dernière requête&nbsp;: <span class="last-request-time">{{ board.last_request }}</span></span>
                                </header>
                                {% if board.last_gpio %}
                                    <div class="board-activity" data-state="{{ board.last_gpio.state }}">
                                        <div class="activity-header">
                                            <strong>{{ board.last_gpio.name }}</strong>
                                            <span class="activity-badge {{ board.last_gpio.state == 1 ? 'on' : 'off' }}">
                                                {{ board.last_gpio.state == 1 ? 'ACTIF' : 'INACTIF' }}
                                            </span>
                                        </div>
                                        <div class="activity-meta">
                                            <span><i class="fas fa-microchip"></i> GPIO {{ board.last_gpio.gpio }}</span>
                                            <span><i class="fas fa-clock"></i> <span class="last-gpio-time">{{ board.last_gpio.last_modified_time }}</span></span>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="board-empty">
                                        <i class="fas fa-circle-notch"></i> Aucune activité récente
                                    </div>
                                {% endif %}
                            </article>
                        {% endfor %}
                    </div>
                </section>
            </aside>

            <section class="control-main panel">
                <header class="control-main-header">
                    <div class="header-left">
                        <h1>Contrôle FFP3</h1>
                        <p>Activez/désactivez les pompes, gérez la programmation automatique et surveillez l'état du système.</p>
                        <div class="callout callout-warning">
                            <i class="fas fa-triangle-exclamation"></i>
                            <span>Les commandes agissent immédiatement sur le système physique. Vérifiez la présence sur site avant d'activer les pompes ou de forcer un reset.</span>
                        </div>
                    </div>
                </header>

                <section class="controls-section">
                    <div class="controls-group">
                        <header>
                            <h2><i class="fas fa-water"></i> Gestion de l'eau</h2>
                        </header>
                        <div class="control-cards-grid">
                            {% set pumpOutputs = [] %}
                            {% for output in outputs %}
                                {% if output.gpio in [16, 18] %}
                                    {% set pumpOutputs = pumpOutputs|merge([output]) %}
                                {% endif %}
                            {% endfor %}
                            {% for output in pumpOutputs %}
                                {% set is_inverted = false %}
                                {% set is_checked = is_inverted ? (output.state == 0) : (output.state == 1) %}
                                <article class="action-card" data-state="{{ is_checked ? '1' : '0' }}" data-gpio="{{ output.gpio }}" data-inverted="{{ is_inverted ? '1' : '0' }}">
                                    <header>
                                        <div class="action-icon">
                                            <i class="fas {{ output.gpio == 16 ? 'fa-water' : 'fa-droplet' }}"></i>
                                        </div>
                                        <div>
                                            <h3>{{ output.gpio == 16 ? 'Pompe aquarium' : 'Pompe réserve' }}</h3>
                                            <span class="sync-status-badge sync-synced" id="sync-badge-{{ output.gpio }}">
                                                <i class="fas fa-sync-alt"></i> SYNC
                                            </span>
                                        </div>
                                    </header>
                                    <footer>
                                        <span data-state-label>{{ is_checked ? 'Activé' : 'Désactivé' }}</span>
                                        <label class="modern-switch" title="{{ output.gpio == 16 ? 'Contrôle pompe aquarium' : 'Contrôle pompe réserve' }}">
                                            <input type="checkbox" onchange="updateOutput(this)" data-id="{{ output.id }}" data-gpio="{{ output.gpio }}" data-inverted="{{ is_inverted ? '1' : '0' }}" {{ is_checked ? 'checked' : '' }} role="switch" aria-checked="{{ is_checked ? 'true' : 'false' }}" aria-label="{{ output.gpio == 16 ? 'Pompe aquarium' : 'Pompe réserve' }}">
                                            <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                        </label>
                                    </footer>
                                </article>
                            {% endfor %}
                        </div>
                        <section class="parameters-panel">
                            <h3>Paramètres de niveau</h3>
                            <div class="parameters-grid">
                                <label class="parameter-item">
                                    <span>Aquarium bas (cm)</span>
                                    <input type="number" name="aqThr" min="0" id="aqThr" data-parameter="aqThr" data-parameter-gpio="{{ parameter_gpio_map['aqThr'] }}" value="{{ params.aqThr|default(0) }}">
                                    <small class="save-indicator" data-save-indicator data-parameter="aqThr" data-state="idle"></small>
                                </label>
                                <label class="parameter-item">
                                    <span>Réserve basse (cm)</span>
                                    <input type="number" name="taThr" min="0" id="taThr" data-parameter="taThr" data-parameter-gpio="{{ parameter_gpio_map['taThr'] }}" value="{{ params.taThr|default(0) }}">
                                    <small class="save-indicator" data-save-indicator data-parameter="taThr" data-state="idle"></small>
                                </label>
                                <label class="parameter-item">
                                    <span>Remplissage (s)</span>
                                    <input type="number" name="tempsRemplissageSec" min="0" id="tempsRemplissageSec" data-parameter="tempsRemplissageSec" data-parameter-gpio="{{ parameter_gpio_map['tempsRemplissageSec'] }}" value="{{ params.tempsRemplissageSec|default(0) }}">
                                    <small class="save-indicator" data-save-indicator data-parameter="tempsRemplissageSec" data-state="idle"></small>
                                </label>
                                <label class="parameter-item">
                                    <span>Débordement (cm)</span>
                                    <input type="number" name="limFlood" min="0" id="limFlood" data-parameter="limFlood" data-parameter-gpio="{{ parameter_gpio_map['limFlood'] }}" value="{{ params.limFlood|default(0) }}">
                                    <small class="save-indicator" data-save-indicator data-parameter="limFlood" data-state="idle"></small>
                                </label>
                            </div>
                        </section>
                    </div>

                    <div class="controls-grid">
                        <article class="controls-column">
                            <header>
                                <h2><i class="fas fa-bowl-food"></i> Nourrissage</h2>
                            </header>
                            <div class="control-cards-grid">
                                {% set feedingOutputs = [] %}
                                {% for output in outputs %}
                                    {% if output.gpio == 108 or output.gpio == 109 %}
                                        {% set feedingOutputs = feedingOutputs|merge([output]) %}
                                    {% endif %}
                                {% endfor %}
                                {% for output in feedingOutputs %}
                                    <article class="action-card" data-state="{{ output.state }}">
                                        <header>
                                            <div class="action-icon"><i class="fas fa-fish"></i></div>
                                            <div>
                                                <h3>{{ output.gpio == 108 ? 'Petits poissons' : 'Gros poissons' }}</h3>
                                            </div>
                                        </header>
                                        <footer>
                                            <span data-state-label>{{ output.state == 1 ? 'Activé' : 'Désactivé' }}</span>
                                            <label class="modern-switch" title="{{ output.gpio == 108 ? 'Nourrissage petits poissons' : 'Nourrissage gros poissons' }}">
                                                <input type="checkbox" onchange="updateOutput(this)" data-id="{{ output.id }}" data-gpio="{{ output.gpio }}" {{ output.state == 1 ? 'checked' : '' }} role="switch" aria-checked="{{ output.state == 1 ? 'true' : 'false' }}" aria-label="{{ output.gpio == 108 ? 'Petits poissons' : 'Gros poissons' }}">
                                                <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                            </label>
                                        </footer>
                                    </article>
                                {% endfor %}
                            </div>

                            <section class="parameters-panel">
                                <h3>Programmation automatique</h3>
                                <div class="parameters-grid">
                                    <label class="parameter-item">
                                        <span>Matin (h)</span>
                                        <input type="number" name="bouffeMat" min="0" max="23" id="bouffeMat" data-parameter="bouffeMat" data-parameter-gpio="{{ parameter_gpio_map['bouffeMat'] }}" value="{{ params.bouffeMat|default(0) }}">
                                        <small class="save-indicator" data-save-indicator data-parameter="bouffeMat" data-state="idle"></small>
                                    </label>
                                    <label class="parameter-item">
                                        <span>Midi (h)</span>
                                        <input type="number" name="bouffeMid" min="0" max="23" id="bouffeMid" data-parameter="bouffeMid" data-parameter-gpio="{{ parameter_gpio_map['bouffeMid'] }}" value="{{ params.bouffeMid|default(0) }}">
                                        <small class="save-indicator" data-save-indicator data-parameter="bouffeMid" data-state="idle"></small>
                                    </label>
                                    <label class="parameter-item">
                                        <span>Soir (h)</span>
                                        <input type="number" name="bouffeSoir" min="0" max="23" id="bouffeSoir" data-parameter="bouffeSoir" data-parameter-gpio="{{ parameter_gpio_map['bouffeSoir'] }}" value="{{ params.bouffeSoir|default(0) }}">
                                        <small class="save-indicator" data-save-indicator data-parameter="bouffeSoir" data-state="idle"></small>
                                    </label>
                                    <label class="parameter-item">
                                        <span>Durée gros (s)</span>
                                        <input type="number" name="tempsGros" min="0" id="tempsGros" data-parameter="tempsGros" data-parameter-gpio="{{ parameter_gpio_map['tempsGros'] }}" value="{{ params.tempsGros|default(0) }}">
                                        <small class="save-indicator" data-save-indicator data-parameter="tempsGros" data-state="idle"></small>
                                    </label>
                                    <label class="parameter-item">
                                        <span>Durée petits (s)</span>
                                        <input type="number" name="tempsPetits" min="0" id="tempsPetits" data-parameter="tempsPetits" data-parameter-gpio="{{ parameter_gpio_map['tempsPetits'] }}" value="{{ params.tempsPetits|default(0) }}">
                                        <small class="save-indicator" data-save-indicator data-parameter="tempsPetits" data-state="idle"></small>
                                    </label>
                                </div>
                            </section>
                        </article>

                        <article class="controls-column">
                            <header>
                                <h2><i class="fas fa-temperature-half"></i> Chauffage & Lumière</h2>
                            </header>
                            <div class="control-cards-grid">
                                {% set heatingOutputs = [] %}
                                {% for output in outputs %}
                                    {% if output.gpio == 2 or output.gpio == 15 %}
                                        {% set heatingOutputs = heatingOutputs|merge([output]) %}
                                    {% endif %}
                                {% endfor %}
                                {% for output in heatingOutputs %}
                                    <article class="action-card" data-state="{{ output.state }}">
                                        <header>
                                            <div class="action-icon"><i class="fas {{ output.gpio == 2 ? 'fa-temperature-high' : 'fa-lightbulb' }}"></i></div>
                                            <div>
                                                <h3>{{ output.gpio == 2 ? 'Radiateur' : 'Lumière' }}</h3>
                                            </div>
                                        </header>
                                        <footer>
                                            <span data-state-label>{{ output.state == 1 ? 'Activé' : 'Désactivé' }}</span>
                                            <label class="modern-switch" title="{{ output.gpio == 2 ? 'Contrôle radiateur' : 'Contrôle lumière' }}">
                                                <input type="checkbox" onchange="updateOutput(this)" data-id="{{ output.id }}" data-gpio="{{ output.gpio }}" {{ output.state == 1 ? 'checked' : '' }} role="switch" aria-checked="{{ output.state == 1 ? 'true' : 'false' }}" aria-label="{{ output.gpio == 2 ? 'Radiateur' : 'Lumière' }}">
                                                <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                            </label>
                                        </footer>
                                    </article>
                                {% endfor %}
                            </div>

                            <section class="parameters-panel">
                                <h3>Paramètres environnementaux</h3>
                                <div class="parameters-grid">
                                    <label class="parameter-item">
                                        <span>Température min (°C)</span>
                                        <input type="number" name="chauff" min="0" step="0.1" id="chauff" data-parameter="chauff" data-parameter-gpio="{{ parameter_gpio_map['chauff'] }}" value="{{ params.chauff|default(0) }}">
                                        <small class="save-indicator" data-save-indicator data-parameter="chauff" data-state="idle"></small>
                                    </label>
                                </div>
                            </section>
                        </article>

                        <article class="controls-column">
                            <header>
                                <h2><i class="fas fa-envelope"></i> Notifications & Système</h2>
                            </header>
                            <div class="control-cards-grid">
                                {% set notificationOutputs = [] %}
                                {% for output in outputs %}
                                    {% if output.gpio == 101 %}
                                        {% set notificationOutputs = notificationOutputs|merge([output]) %}
                                    {% endif %}
                                {% endfor %}
                                {% for output in notificationOutputs %}
                                    <article class="action-card" data-state="{{ output.state }}">
                                        <header>
                                            <div class="action-icon"><i class="fas fa-bell"></i></div>
                                            <div>
                                                <h3>Notifications email</h3>
                                            </div>
                                        </header>
                                        <footer>
                                            <span data-state-label>{{ output.state == 1 ? 'Activé' : 'Désactivé' }}</span>
                                            <label class="modern-switch" title="Activer/désactiver les notifications email">
                                                <input type="checkbox" onchange="updateOutput(this)" data-id="{{ output.id }}" data-gpio="{{ output.gpio }}" {{ output.state == 1 ? 'checked' : '' }} role="switch" aria-checked="{{ output.state == 1 ? 'true' : 'false' }}" aria-label="Notifications email">
                                                <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                            </label>
                                        </footer>
                                    </article>
                                {% endfor %}

                                {% set systemOutputs = [] %}
                                {% for output in outputs %}
                                    {% if output.gpio == 110 or output.gpio == 115 %}
                                        {% set systemOutputs = systemOutputs|merge([output]) %}
                                    {% endif %}
                                {% endfor %}
                                {% for output in systemOutputs %}
                                    <article class="action-card warning" data-state="{{ output.state }}">
                                        <header>
                                            <div class="action-icon"><i class="fas {{ output.gpio == 110 ? 'fa-arrows-rotate' : 'fa-clock' }}"></i></div>
                                            <div>
                                                <h3>{{ output.gpio == 110 ? 'Reset ESP' : 'Forçage réveil' }}</h3>
                                        </div>
                                        </header>
                                        <p class="action-description">{{ output.gpio == 110 ? 'Redémarre le microcontrôleur. À utiliser en dernier recours.' : 'Force le réveil de l\'ESP32 pour envoyer toutes les mesures.' }}</p>
                                        <footer>
                                            <span data-state-label>{{ output.state == 1 ? 'Activé' : 'Désactivé' }}</span>
                                            <label class="modern-switch" title="{{ output.gpio == 110 ? 'Redémarrer le microcontrôleur' : 'Forcer le réveil de l\'ESP32' }}">
                                                <input type="checkbox" onchange="updateOutput(this)" data-id="{{ output.id }}" data-gpio="{{ output.gpio }}" {{ output.state == 1 ? 'checked' : '' }} role="switch" aria-checked="{{ output.state == 1 ? 'true' : 'false' }}" aria-label="{{ output.gpio == 110 ? 'Reset ESP' : 'Forçage réveil' }}">
                                                <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                            </label>
                                        </footer>
                                    </article>
                                {% endfor %}
                            </div>

                            <section class="parameters-panel">
                                <h3>Configuration</h3>
                                <div class="parameters-grid">
                                    <label class="parameter-item">
                                        <span>Email d'alerte</span>
                                        <input type="email" name="mail" id="mail" data-parameter="mail" data-parameter-gpio="{{ parameter_gpio_map['mail'] }}" value="{{ params.mail|default('') }}" placeholder="email@exemple.com">
                                        <small class="save-indicator" data-save-indicator data-parameter="mail" data-state="idle"></small>
                                    </label>
                                    <label class="parameter-item">
                                        <span>Wake Up (s)</span>
                                        <input type="number" name="FreqWakeUp" min="0" id="FreqWakeUp" data-parameter="FreqWakeUp" data-parameter-gpio="{{ parameter_gpio_map['FreqWakeUp'] }}" value="{{ params.FreqWakeUp|default(0) }}">
                                        <small class="save-indicator" data-save-indicator data-parameter="FreqWakeUp" data-state="idle"></small>
                                    </label>
                                </div>
                            </section>
                        </article>
                    </div>
                </section>
            </section>

            <section class="quick-actions panel">
                <h3><i class="fas fa-bolt"></i> Actions rapides</h3>
                <div class="quick-actions-grid">
                    <a href="/ffp3/aquaponie{{ environment == 'test' ? '-test' : '' }}" class="quick-action-card">
                        <i class="fas fa-chart-line"></i>
                        <span>Retour aux données</span>
                    </a>
                    <a href="/ffp3/cronpompe.php" class="quick-action-card">
                        <i class="fas fa-rotate"></i>
                        <span>Exécuter cron</span>
                    </a>
                    <a href="/ffp3/cronlog.txt" class="quick-action-card">
                        <i class="fas fa-file-lines"></i>
                        <span>Logs cron</span>
                    </a>
                </div>
            </section>
        </div>

        <script src="/ffp3/assets/js/control-sync.js"></script>
        <script src="/ffp3/assets/js/control-values-updater.js"></script>
        <script src="/ffp3/assets/js/toast-notifications.js"></script>
        <script src="/ffp3/assets/js/control-actions.js"></script>
        <script src="/ffp3/assets/js/control-auto-save.js"></script>
        <script src="/ffp3/assets/js/realtime-updater.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const controlSync = new ControlSync({
                    apiBase: '/ffp3/api/outputs',
                    pollInterval: {{ environment == 'test' ? 6 : 10 }},
                    maxRetries: 5
                });

                const valuesUpdater = new ControlValuesUpdater();
                valuesUpdater.init();

                controlSync.start();

                window.controlSync = controlSync;
                window.controlValuesUpdater = valuesUpdater;

                const realtimeApiBase = '{{ environment == "test" ? "/ffp3/api/realtime-test" : "/ffp3/api/realtime" }}';
                initRealtimeUpdater({
                    apiBasePath: realtimeApiBase,
                    pollInterval: 15000,
                    enabled: true
                });
            });
        </script>
</body>
